{
  "version": 3,
  "overrides": {},
  "routes": [
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/builds/meta/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=1, immutable"
      },
      "src": "/_nuxt/builds/(.*)"
    },
    {
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "src": "/_nuxt/(.*)"
    },
    {
      "src": "/_nuxt/builds/meta(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/builds(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "src": "/_nuxt(.*)",
      "headers": {
        "cache-control": "public,max-age=31536000,immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "(?<__isr_route>/__nuxt_error)",
      "dest": "/__fallback"
    },
    {
      "src": "/profiles",
      "dest": "/profiles"
    },
    {
      "src": "/messages",
      "dest": "/messages"
    },
    {
      "src": "/login",
      "dest": "/login"
    },
    {
      "src": "/kid/library",
      "dest": "/kid/library"
    },
    {
      "src": "/kid",
      "dest": "/kid"
    },
    {
      "src": "/home",
      "dest": "/home"
    },
    {
      "src": "/feedback",
      "dest": "/feedback"
    },
    {
      "src": "/family/add",
      "dest": "/family/add"
    },
    {
      "src": "/family",
      "dest": "/family"
    },
    {
      "src": "/books/new",
      "dest": "/books/new"
    },
    {
      "src": "/api/messages",
      "dest": "/api/messages"
    },
    {
      "src": "/api/members",
      "dest": "/api/members"
    },
    {
      "src": "/api/files",
      "dest": "/api/files"
    },
    {
      "src": "/api/feedback",
      "dest": "/api/feedback"
    },
    {
      "src": "/api/books",
      "dest": "/api/books"
    },
    {
      "src": "/api/auth/me",
      "dest": "/api/auth/me"
    },
    {
      "src": "/api/auth/logout",
      "dest": "/api/auth/logout"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login"
    },
    {
      "src": "/__nuxt_error",
      "dest": "/__nuxt_error"
    },
    {
      "src": "/",
      "dest": "/index"
    },
    {
      "src": "/message/listen/(?<id>[^/]+)",
      "dest": "/message/listen/[id]"
    },
    {
      "src": "/message/(?<toId>[^/]+)",
      "dest": "/message/[toId]"
    },
    {
      "src": "/kid/listen/(?<id>[^/]+)",
      "dest": "/kid/listen/[id]"
    },
    {
      "src": "/kid/(?<id>[^/]+)",
      "dest": "/kid/[id]"
    },
    {
      "src": "/family/(?<id>[^/]+)",
      "dest": "/family/[id]"
    },
    {
      "src": "/books/(?<id>[^/]+)/studio",
      "dest": "/books/[id]/studio"
    },
    {
      "src": "/books/(?<id>[^/]+)/play",
      "dest": "/books/[id]/play"
    },
    {
      "src": "/api/messages/(?<id>[^/]+)/listen",
      "dest": "/api/messages/[id]/listen"
    },
    {
      "src": "/api/members/(?<id>[^/]+)",
      "dest": "/api/members/[id]"
    },
    {
      "src": "/api/files/(?<id>[^/]+)",
      "dest": "/api/files/[id]"
    },
    {
      "src": "/api/books/(?<id>[^/]+)/lines/(?<lineId>[^/]+)/audio",
      "dest": "/api/books/[id]/lines/[lineId]/audio"
    },
    {
      "src": "/api/books/(?<id>[^/]+)",
      "dest": "/api/books/[id]"
    },
    {
      "src": "/__nuxt_island/(?:.*)",
      "dest": "/__nuxt_island/[...]"
    },
    {
      "src": "/(.*)",
      "dest": "/__fallback"
    }
  ]
}
ext-align: center;\n    align-items: center;\n    justify-content: center;\n}\n\n.card {\n    background: var(--paper);\n    border: 2.5px solid var(--ink);\n    border-radius: 20px;\n    box-shadow: var(--shadow);\n    padding: 14px;\n}\n\n.card--tap {\n    cursor: pointer;\n    text-align: left;\n    width: 100%;\n    font: inherit;\n}\n\n.card--tap:active,\n.btn:active:not(:disabled) {\n    transform: translate(3px, 3px);\n    box-shadow: 0 0 0 var(--ink);\n}\n\n.btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    min-height: 50px;\n    padding: 12px 20px;\n    border: 3px solid var(--ink);\n    border-radius: 18px;\n    background: var(--sun);\n    box-shadow: 4px 4px 0 var(--ink);\n    font: 700 17px/1 var(--font-title);\n    cursor: pointer;\n    text-decoration: none;\n    color: var(--ink);\n}\n\n.btn:disabled {\n    opacity: 0.45;\n    cursor: not-allowed;\n}\n\n.btn--white {\n    background: var(--paper);\n}\n\n.btn--coral {\n    background: var(--coral);\n}\n\n.btn--mint {\n    background: var(--mint);\n}\n\n.btn--block {\n    width: 100%;\n}\n\n.btn--small {\n    min-height: 40px;\n    padding: 8px 14px;\n    font-size: 15px;\n    border-radius: 14px;\n    box-shadow: 3px 3px 0 var(--ink);\n}\n\n.btn--round {\n    width: 52px;\n    min-height: 52px;\n    padding: 0;\n    border-radius: 50%;\n}\n\n.input {\n    width: 100%;\n    min-height: 48px;\n    padding: 12px 14px;\n    border: 2.5px solid var(--ink);\n    border-radius: 14px;\n    background: var(--paper);\n    font: 700 16px/1.3 var(--font-body);\n}\n\n.input:focus {\n    outline: 3px solid var(--sky);\n    outline-offset: 1px;\n}\n\ntextarea.input {\n    resize: vertical;\n    min-height: 80px;\n}\n\n.label {\n    font: 700 14px/1 var(--font-title);\n}\n\n.chip {\n    border: 2.5px solid var(--ink);\n    border-radius: 999px;\n    background: var(--paper);\n    padding: 8px 14px;\n    font: 700 14px/1 var(--font-title);\n    cursor: pointer;\n}\n\n.chip--on {\n    background: var(--ink);\n    color: var(--cream);\n}\n\n.avatar {\n    width: 44px;\n    height: 44px;\n    border: 2.5px solid var(--ink);\n    border-radius: 50%;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font: 700 20px/1 var(--font-title);\n    background-size: cover;\n    background-position: center;\n    flex-shrink: 0;\n}\n\n.badge {\n    display: inline-block;\n    border: 2px solid var(--ink);\n    border-radius: 999px;\n    padding: 3px 10px;\n    font: 700 12px/1.3 var(--font-title);\n    background: var(--cream);\n}\n\n.error {\n    color: #b3261e;\n    font-weight: 800;\n    font-size: 14px;\n}\n\n.progress {\n    height: 12px;\n    border: 2.5px solid var(--ink);\n    border-radius: 999px;\n    background: var(--paper);\n    overflow: hidden;\n}\n\n.progress__fill {\n    height: 100%;\n    background: var(--mint);\n    transition: width 0.2s;\n}\n\n.dots {\n    display: flex;\n}\n\n.dots > * + * {\n    margin-left: -6px;\n}\n\n.dot {\n    width: 18px;\n    height: 18px;\n    border-radius: 50%;\n    border: 2px solid var(--ink);\n    display: inline-block;\n}\n\n.sheet-backdrop {\n    position: fixed;\n    inset: 0;\n    background: rgba(31, 27, 58, 0.45);\n    z-index: 50;\n    display: flex;\n    align-items: flex-end;\n    justify-content: center;\n}\n\n.sheet {\n    width: 100%;\n    max-width: 560px;\n    max-height: 88dvh;\n    overflow-y: auto;\n    background: var(--cream);\n    border: 3px solid var(--ink);\n    border-bottom: 0;\n    border-radius: 28px 28px 0 0;\n    padding: 20px 16px calc(env(safe-area-inset-bottom) + 20px);\n}\n\n.tabbar {\n    position: fixed;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    z-index: 20;\n    display: flex;\n    justify-content: center;\n    padding-bottom: env(safe-area-inset-bottom);\n    background: var(--cream);\n    border-top: 3px solid var(--ink);\n}\n\n.tabbar__inner {\n    width: 100%;\n    max-width: 560px;\n    display: flex;\n}\n\n.tabbar__item {\n    flex: 1;\n    padding: 12px 4px;\n    text-align: center;\n    font: 700 13px/1 var(--font-title);\n    color: var(--ink);\n    text-decoration: none;\n    position: relative;\n}\n\n.tabbar__item--on {\n    background: var(--sun);\n}\n\n.pop {\n    position: absolute;\n    top: 6px;\n    right: calc(50% - 26px);\n    width: 12px;\n    height: 12px;\n    border-radius: 50%;\n    background: var(--coral);\n    border: 2px solid var(--ink);\n}\n\n@keyframes bounce {\n    0%,\n    100% {\n        transform: translateY(0);\n    }\n    50% {\n        transform: translateY(-8px);\n    }\n}\n\n@keyframes pulse {\n    0%,\n    100% {\n        transform: scale(1);\n    }\n    50% {\n        transform: scale(1.06);\n    }\n}\n\n.anim-bounce {\n    animation: bounce 1s ease-in-out infinite;\n}\n\n.anim-pulse {\n    animation: pulse 1.2s ease-in-out infinite;\n}\n\n.picker {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 4px 12px 4px 4px;\n    border: 2.5px solid var(--ink);\n    border-radius: 999px;\n    background: var(--paper);\n    font: 700 14px/1 var(--font-title);\n    cursor: pointer;\n}\n\n.picker--on {\n    box-shadow: 3px 3px 0 var(--ink);\n}\n\na {\n    color: inherit;\n}\n\n.grid {\n    display: grid;\n    gap: 14px;\n    grid-template-columns: 1fr;\n}\n\n.nav {\n    display: none;\n}\n\n@media (min-width: 720px) {\n    .app {\n        max-width: 880px;\n        padding: calc(env(safe-area-inset-top) + 20px) 28px 48px;\n        gap: 20px;\n    }\n\n    .app--full {\n        padding-bottom: 28px;\n    }\n\n    .title {\n        font-size: 34px;\n    }\n\n    .grid--books {\n        grid-template-columns: repeat(2, 1fr);\n    }\n\n    .grid--people {\n        grid-template-columns: repeat(2, 1fr);\n    }\n\n    .tabbar {\n        display: none;\n    }\n\n    .nav {\n        display: flex;\n        gap: 8px;\n        flex: 1;\n        margin-left: 18px;\n    }\n\n    .nav__item {\n        padding: 10px 16px;\n        border: 2.5px solid transparent;\n        border-radius: 14px;\n        font: 700 15px/1 var(--font-title);\n        text-decoration: none;\n        color: var(--ink);\n        position: relative;\n    }\n\n    .nav__item--on {\n        background: var(--sun);\n        border-color: var(--ink);\n        box-shadow: var(--shadow);\n    }\n\n    .narrow {\n        max-width: 640px;\n        width: 100%;\n        margin-left: auto;\n        margin-right: auto;\n    }\n\n    .sheet-backdrop {\n        align-items: center;\n    }\n\n    .sheet {\n        border-bottom: 3px solid var(--ink);\n        border-radius: 28px;\n    }\n}\n\n@media (min-width: 1100px) {\n    .app {\n        max-width: 1120px;\n    }\n\n    .grid--books {\n        grid-template-columns: repeat(3, 1fr);\n    }\n\n    .grid--people {\n        grid-template-columns: repeat(3, 1fr);\n    }\n}\n\n/*# sourceMappingURL=data:application/json;base64, */"]],["BODY",{},["DIV",{"id":"__nuxt","data-v-app":""},["DIV",{},["SPAN",{"class":"nuxt-route-announcer","style":"position: absolute;"},["SPAN",{"role":"status","aria-live":"polite","aria-atomic":"false","style":"border: 0px; clip: rect(0px, 0px, 0px, 0px); clip-path: inset(50%); height: 1px; width: 1px; overflow: hidden; position: absolute; white-space: nowrap; overflow-wrap: normal; margin: -1px; padding: 0px;"},"Tantara"]],["DIV",{"class":"app app--full"},"",["DIV",{"class":"stack narrow"},["DIV",{"class":"row","style":"justify-content: space-between;"},["svg",{"viewBox":"0 0 120 120","width":"48","height":"48","style":"display: block; overflow: visible;"},["path",{"d":"M31 42 L22 12 L50 30 Z","fill":"#8E889C"}],["path",{"d":"M89 42 L98 12 L70 30 Z","fill":"#8E889C"}],["path",{"d":"M31 38 L27 21 L42 31 Z","fill":"#2B2640"}],["path",{"d":"M89 38 L93 21 L78 31 Z","fill":"#2B2640"}],["ellipse",{"cx":"60","cy":"64","rx":"37","ry":"35","fill":"#AFA9BE"}],["ellipse",{"cx":"60","cy":"70","rx":"29","ry":"28","fill":"#FFFFFF"}],["ellipse",{"cx":"46","
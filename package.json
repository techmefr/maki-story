{
  "name": "tantara",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "cap:sync": "nuxt generate && cap sync",
    "typecheck": "nuxt typecheck",
    "migrate:up": "node --experimental-strip-types scripts/migrate.ts up",
    "migrate:down": "node --experimental-strip-types scripts/migrate.ts down",
    "test:e2e": "playwright test",
    "i18n:check": "node --experimental-strip-types scripts/check-i18n.ts",
    "lint": "node --experimental-strip-types scripts/lint.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "check:docs": "node --experimental-strip-types scripts/check-docs-pages.ts",
    "audit:design": "node --experimental-strip-types scripts/design-audit.ts",
    "check:migrations": "node --experimental-strip-types scripts/check-migrations.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm i18n:check && pnpm check:docs && pnpm audit:design && pnpm test:unit && pnpm check:migrations",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "nuxt-osdd": "^1.0.5",
    "postgres": "^3.4.9",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@capgo/capacitor-native-biometric": "^8.7.0"
  }
}
